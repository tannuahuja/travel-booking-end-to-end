pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Validate scaffold') {
            steps {
                sh 'git status --short'
                sh 'test -f README.md'
            }
        }
        // Test, SonarQube, Trivy, image publishing and GitOps stages
        // will be added after we review credentials and pipeline security.
    }
}
